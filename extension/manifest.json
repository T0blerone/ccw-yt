{
  "manifest_version": 3,
  "name": "ccw-yt",
  "version": "0.1.0",
  "description": "Counter-Clockwise mindful session timer and duration-based feed filter for YouTube.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://youtube.com/*",
    "*://m.youtube.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{c94e7a12-4b8d-4f31-9e6a-2d5b8f017c3e}",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "background": {
    "scripts": [
      "src/background/index.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "ccw-yt",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://m.youtube.com/*"
      ],
      "js": [
        "src/content/redirect-mobile.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": [
        "src/content/speed-guard-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*"
      ],
      "css": [
        "src/content/cloak.css"
      ],
      "js": [
        "src/shared/ext.js",
        "src/shared/icons.js",
        "src/shared/state.js",
        "src/shared/settings-panel.js",
        "src/content/tab-allowance.js",
        "src/content/media-guard.js",
        "src/content/entry-gate.js",
        "src/content/search-only.js",
        "src/content/hud.js",
        "src/content/feed-filter.js",
        "src/content/watch-guard.js",
        "src/content/watch-focus.js",
        "src/content/distractions.js",
        "src/content/bootstrap.js"
      ],
      "run_at": "document_start"
    }
  ]
}
